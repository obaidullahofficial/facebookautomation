# Optional: You can set these in .env or via the Settings dashboard
PORT=3000

# Google Gemini API (get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook (configure via Settings dashboard in the app)
FB_PAGE_ID=your_page_id
FB_ACCESS_TOKEN=your_long_lived_page_access_token
